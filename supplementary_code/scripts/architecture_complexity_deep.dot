digraph ComplexityDeep {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad=0.18,
    nodesep=0.52,
    ranksep=0.58,
    splines=polyline,
    outputorder=edgesfirst
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#5E6670",
    fillcolor="#F7F8FA",
    fontname="Helvetica",
    fontsize=11,
    penwidth=1.15,
    margin="0.16,0.11"
  ];

  edge [
    color="#176B87",
    fontcolor="#343A40",
    fontname="Helvetica",
    fontsize=9.5,
    penwidth=1.45,
    arrowsize=0.72
  ];

  state [label=<Contextual hidden state<BR/><I>x</I><SUB>l</SUB>>, width=1.85];
  token [label=<Token identifier<BR/><I>t</I>>, width=1.85];

  shared [
    label=<Shared SwiGLU<BR/><FONT POINT-SIZE="9.5">width 3,840 · all tokens · gate <I>g</I><SUB>l</SUB><SUP>s</SUP></FONT>>,
    fillcolor="#FFF2C7",
    width=2.30
  ];

  lookup [
    label=<Fixed route pair (<I>r</I><SUB>l,1</SUB>(<I>t</I>), <I>r</I><SUB>l,2</SUB>(<I>t</I>))<BR/><FONT POINT-SIZE="9.5">selects 2 of 4 experts</FONT>>,
    color="#6B4FA3",
    fillcolor="#F1ECFA",
    width=2.30
  ];

  experts [
    label=<Selected residual experts<BR/><FONT POINT-SIZE="9.5">width 64 each · weights 0.5 / 0.5 · gate <I>g</I><SUB>l</SUB><SUP>r</SUP></FONT>>,
    color="#397B56",
    fillcolor="#E8F4EC",
    width=2.65
  ];

  sum [
    label="+",
    shape=circle,
    fixedsize=true,
    width=0.58,
    height=0.58,
    margin=0,
    fontsize=17,
    fillcolor="#F7F8FA"
  ];

  output [label=<Feed-forward output>, width=1.70];

  { rank=same; state; token; }
  { rank=same; shared; experts; lookup; }
  { rank=same; sum; output; }

  state -> shared;
  shared -> sum;

  state -> experts;
  experts -> sum;

  token -> lookup [
    color="#6B4FA3",
    style=dashed,
    penwidth=1.35
  ];
  lookup -> experts [
    color="#6B4FA3",
    style=dashed,
    penwidth=1.35,
    constraint=false
  ];

  sum -> output;

  state -> token [style=invis, weight=25];
  shared -> experts [style=invis, weight=25];
  experts -> lookup [style=invis, weight=25];
}
